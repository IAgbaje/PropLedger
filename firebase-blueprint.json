    "AuditLogRecord": {
      "title": "AuditLogRecord",
      "description": "Append-only operational audit trail record.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
