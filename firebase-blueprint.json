        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tenantId": { "type": "string", "maxLength": 128 },
        "obligationIds": { "type": "array" },
        "promisedAmount": { "type": "number" },
        "promisedDate": { "type": "string", "maxLength": 20 },
        "extendedUntilDate": { "type": "string", "maxLength": 20 },
        "instalments": { "type": "array" },
        "status": { "type": "string", "enum": ["Open", "Partially Fulfilled", "Fulfilled", "Breached", "Cancelled"] },
        "dateRecorded": { "type": "string", "maxLength": 40 },
        "recordedBy": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 1000 },
        "cancellationReason": { "type": "string", "maxLength": 300 },
        "syncedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "id", "tenantId", "obligationIds", "promisedAmount", "promisedDate", "instalments", "status", "dateRecorded", "recordedBy", "notes", "syncedAt"]
    },
