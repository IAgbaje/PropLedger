{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Non-PII public profile record for an authenticated user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "maxLength": 120 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record for an authenticated user (email and role).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "role": { "type": "string", "enum": ["manager", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Server-managed administrator role assignment document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Root property ledger workspace containing property profile and system policy settings.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referenceDate": { "type": "string", "maxLength": 20 },
        "property": { "type": "object" },
        "settings": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "referenceDate", "property", "settings", "createdAt", "updatedAt"]
    },
    "UnitRecord": {
      "title": "UnitRecord",
      "description": "Rentable unit in the property portfolio.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "type": { "type": "string", "enum": ["Bedroom", "Room", "Room & Parlour", "Shop", "Kiosk", "Container Shop", "Other"] },
        "floorOrWing": { "type": "string", "maxLength": 80 },
        "occupancyStatus": { "type": "string", "enum": ["Occupied", "Vacant", "Under Maintenance"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "syncedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "id", "code", "name", "type", "floorOrWing", "occupancyStatus", "syncedAt"]
    },
    "TenantRecord": {
      "title": "TenantRecord",
      "description": "Tenant contact and compliance record (PII protected per owner/admin).",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "firstName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "lastName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "phone": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 254 },
        "archived": { "type": "boolean" },
        "notificationsPaused": { "type": "boolean" },
        "pauseReason": { "type": "string", "maxLength": 300 },
        "behaviourOverride": { "type": "string", "maxLength": 60 },
        "behaviourOverrideReason": { "type": "string", "maxLength": 300 },
        "historicalLateCycles": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 40 },
        "notes": { "type": "string", "maxLength": 1000 },
        "syncedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "id", "firstName", "lastName", "phone", "email", "archived", "notificationsPaused", "historicalLateCycles", "createdAt", "syncedAt"]
    },
    "AgreementRecord": {
      "title": "AgreementRecord",
      "description": "Lease agreement linking a tenant to a unit.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "unitId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["Draft", "Active", "Expired", "Renewed / Superseded", "Terminated", "Cancelled"] },
        "rentCycle": { "type": "string", "enum": ["Yearly", "Bi-Annual", "Quarterly", "Monthly"] },
        "agreedRent": { "type": "number" },
        "securityLevy": { "type": "number" },
        "startDate": { "type": "string", "maxLength": 20 },
        "endDate": { "type": "string", "maxLength": 20 },
        "dueDate": { "type": "string", "maxLength": 20 },
        "supersededById": { "type": "string", "maxLength": 128 },
        "previousAgreementId": { "type": "string", "maxLength": 128 },
        "exceptionNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "syncedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "id", "tenantId", "unitId", "status", "rentCycle", "agreedRent", "securityLevy", "startDate", "endDate", "dueDate", "createdAt", "syncedAt"]
    },
    "ObligationRecord": {
      "title": "ObligationRecord",
      "description": "Billed rent or security levy charge.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "agreementId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "unitId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "chargeType": { "type": "string", "enum": ["Rent", "Security Levy", "Other Charge"] },
        "rentalPeriodLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
        "originalAmount": { "type": "number" },
        "dueDate": { "type": "string", "maxLength": 20 },
        "underReview": { "type": "boolean" },
        "reviewReason": { "type": "string", "maxLength": 300 },
        "settledAt": { "type": "string", "maxLength": 40 },
        "settledLateDays": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 40 },
        "syncedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "id", "agreementId", "tenantId", "unitId", "chargeType", "rentalPeriodLabel", "originalAmount", "dueDate", "underReview", "createdAt", "syncedAt"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Recorded rent or levy payment and obligation allocations.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "systemRef": { "type": "string", "maxLength": 64 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "agreementId": { "type": "string", "maxLength": 128 },
        "unitId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "dateReceived": { "type": "string", "maxLength": 20 },
        "dateRecorded": { "type": "string", "maxLength": 40 },
        "method": { "type": "string", "enum": ["Bank Transfer", "POS", "Cash", "Cheque"] },
        "bankReference": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["Confirmed", "Reversed"] },
        "allocations": { "type": "array" },
        "unappliedAmount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 },
        "recordedBy": { "type": "string", "maxLength": 120 },
        "duplicateFlag": { "type": "boolean" },
        "reversalReason": { "type": "string", "maxLength": 300 },
        "reversedAt": { "type": "string", "maxLength": 40 },
        "adjustedFromPaymentId": { "type": "string", "maxLength": 128 },
        "syncedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "id", "systemRef", "tenantId", "agreementId", "unitId", "amount", "dateReceived", "dateRecorded", "method", "bankReference", "status", "allocations", "unappliedAmount", "notes", "recordedBy", "syncedAt"]
    },
    "ReceiptRequestRecord": {
      "title": "ReceiptRequestRecord",
      "description": "Receipt issuance tracking and SLA workflow record.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "paymentId": { "type": "string", "maxLength": 128 },
        "paymentRef": { "type": "string", "maxLength": 64 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "unitId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "datePaid": { "type": "string", "maxLength": 20 },
        "rentalPeriodCovered": { "type": "string", "maxLength": 160 },
        "securityLevyIncluded": { "type": "number" },
        "remainingBalanceAtPayment": { "type": "number" },
        "issuerContactId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["Created", "Notified", "Acknowledged", "Overdue", "Issued", "Correction Required", "Cancelled"] },
        "createdAt": { "type": "string", "maxLength": 40 },
        "slaDeadlineAt": { "type": "string", "maxLength": 40 },
        "acknowledgedAt": { "type": "string", "maxLength": 40 },
        "acknowledgedNote": { "type": "string", "maxLength": 300 },
        "officialReceiptNumber": { "type": "string", "maxLength": 80 },
        "issuedDate": { "type": "string", "maxLength": 20 },
        "evidenceNote": { "type": "string", "maxLength": 500 },
        "cancellationReason": { "type": "string", "maxLength": 300 },
        "syncedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "id", "paymentId", "paymentRef", "tenantId", "unitId", "amount", "datePaid", "rentalPeriodCovered", "securityLevyIncluded", "remainingBalanceAtPayment", "issuerContactId", "status", "createdAt", "slaDeadlineAt", "syncedAt"]
    },
    "NotificationLogRecord": {
      "title": "NotificationLogRecord",
      "description": "Email and SMS dispatch record including BulkSMSLive DLR metadata.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "eventId": { "type": "string", "maxLength": 128 },
        "eventType": { "type": "string", "maxLength": 80 },
        "relatedRecordId": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "recipientName": { "type": "string", "maxLength": 120 },
        "recipientRole": { "type": "string", "maxLength": 60 },
        "recipientContact": { "type": "string", "maxLength": 254 },
        "channel": { "type": "string", "enum": ["SMS", "Email"] },
        "status": { "type": "string", "enum": ["Queued", "Sent", "Delivered", "Failed", "Retry Pending", "Exhausted / Action Required", "Cancelled"] },
        "subject": { "type": "string", "maxLength": 300 },
        "messageBody": { "type": "string", "maxLength": 8000 },
        "scheduledAt": { "type": "string", "maxLength": 40 },
        "attemptedAt": { "type": "string", "maxLength": 40 },
        "retryCount": { "type": "number" },
        "failureReason": { "type": "string", "maxLength": 500 },
        "isCustom": { "type": "boolean" },
        "deliveryProvider": { "type": "string", "maxLength": 40 },
        "externalMessageId": { "type": "string", "maxLength": 200 },
        "smsUnits": { "type": "number" },
        "smsCostNaira": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 120 },
        "overrideQuietHours": { "type": "boolean" },
        "cancelledAt": { "type": "string", "maxLength": 40 },
        "syncedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "id", "eventId", "eventType", "relatedRecordId", "recipientName", "recipientRole", "recipientContact", "channel", "status", "messageBody", "scheduledAt", "retryCount", "syncedAt"]
    },
    "SmsTemplateRecord": {
      "title": "SmsTemplateRecord",
      "description": "Reusable SMS template with placeholder tokens.",
