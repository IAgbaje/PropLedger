        "eligibleRentCollected": { "type": "number" },
        "accruedAmount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 40 },
        "isReversalAdjustment": { "type": "boolean" },
        "note": { "type": "string", "maxLength": 400 },
        "syncedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "id", "paymentId", "agreementId", "tenantId", "ratePercent", "eligibleRentCollected", "accruedAmount", "createdAt", "note", "syncedAt"]
