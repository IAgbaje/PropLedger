        "body": { "type": "string", "minLength": 1, "maxLength": 1600 },
        "updatedAt": { "type": "string", "maxLength": 40 },
        "syncedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "id", "name", "category", "body", "updatedAt", "syncedAt"]
    },
